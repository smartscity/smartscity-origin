---
interface Props {
  label: string;
  lang?: string;
}
const { label, lang = 'en' } = Astro.props;
const modules = [
  {
    x: 150,
    y: 115,
    name: 'HyperRaft',
    mark: '↗',
    subtitle: lang === 'en' ? 'CONSENSUS' : '共识与复制',
  },
  {
    x: 790,
    y: 100,
    name: 'Polarbear',
    mark: 'Aa',
    subtitle: lang === 'en' ? 'WORKSPACE' : '写作空间',
  },
  {
    x: 215,
    y: 315,
    name: 'QualitySphere',
    mark: '✓',
    subtitle: lang === 'en' ? 'ENGINEERING QUALITY' : '工程质量',
  },
  {
    x: 760,
    y: 310,
    name: 'Polarbear Vocab',
    mark: 'a',
    subtitle: lang === 'en' ? 'VOCABULARY' : '词汇学习',
  },
];
---

<div class="network-art" data-parallax role="img" aria-label={label}>
  <svg viewBox="0 0 1000 440" aria-hidden="true">
    <defs>
      <linearGradient id="chip-edge" x1="0" y1="0" x2="1" y2="1">
        <stop stop-color="var(--chip-edge)" />
        <stop offset=".5" stop-color="var(--surface2)" />
        <stop offset="1" stop-color="var(--chip-edge)" />
      </linearGradient>
      <linearGradient id="chip-face" x1="0" y1="0" x2="1" y2="1">
        <stop stop-color="#343438" />
        <stop offset="1" stop-color="#101012" />
      </linearGradient>
      <radialGradient id="scene-glow">
        <stop stop-color="var(--accent)" stop-opacity=".12" />
        <stop offset="1" stop-color="var(--accent)" stop-opacity="0" />
      </radialGradient>
      <filter id="chip-shadow" x="-60%" y="-60%" width="220%" height="240%">
        <feDropShadow
          dx="0"
          dy="16"
          stdDeviation="13"
          flood-color="#000"
          flood-opacity=".14"
        />
      </filter>
    </defs>
    <ellipse cx="500" cy="250" rx="350" ry="185" fill="url(#scene-glow)" />
    <g
      class="network-wires"
      fill="none"
      stroke="var(--line)"
      stroke-width="1.5"
    >
      <path d="M150 115 H310 Q345 115 365 150 L500 220 L680 100 H790 M215 315 H320 L500 220 L650 310 H760" />
    </g>
    <g
      class="travel-wires"
      fill="none"
      stroke="var(--accent)"
      stroke-width="2.5"
    >
      <path d="M150 115 H310 Q345 115 365 150 L500 220 L650 310 H760" />
      <path d="M215 315 H320 L500 220 L680 100 H790" />
    </g>
    <g class="core-float">
      <g
        transform="translate(500 215) rotate(-22) skewX(25)"
        filter="url(#chip-shadow)"
      >
        <rect
          x="-115"
          y="-66"
          width="230"
          height="160"
          rx="28"
          fill="url(#chip-edge)"
          stroke="var(--line)"
        />
        <rect
          x="-115"
          y="-80"
          width="230"
          height="160"
          rx="28"
          fill="url(#chip-edge)"
          stroke="var(--chip-edge)"
        />
        <rect
          x="-115"
          y="-96"
          width="230"
          height="160"
          rx="28"
          fill="url(#chip-face)"
          stroke="#63636a"
        />
        <rect
          x="-104"
          y="-85"
          width="208"
          height="138"
          rx="22"
          fill="none"
          stroke="#55555c"
        />
        <text
          x="0"
          y="-6"
          text-anchor="middle"
          font-size="47"
          font-weight="650"
          letter-spacing="-3"
          fill="#fff"
        >
          S.
        </text>
        <text
          x="0"
          y="28"
          text-anchor="middle"
          font-size="9"
          letter-spacing="3"
          fill="#dedee3"
        >
          SMARTSCITY
        </text>
      </g>
    </g>
    {modules.map((module, i) => (
      <g
        class={`ecosystem-module module-${i}`}
        style={`--module-delay:${i * -0.8}s`}
      >
        <rect
          x={module.x - 46}
          y={module.y - 41}
          width="92"
          height="82"
          rx="22"
          fill="var(--surface)"
          stroke="var(--chip-edge)"
          filter="url(#chip-shadow)"
        />
        <text
          x={module.x}
          y={module.y + 9}
          text-anchor="middle"
          fill="var(--text)"
          font-size="30"
          font-weight="550"
        >
          {module.mark}
        </text>
        <text
          x={module.x}
          y={module.y + 68}
          text-anchor="middle"
          fill="var(--text)"
          font-size="15"
          font-weight="600"
        >
          {module.name}
        </text>
        <text
          x={module.x}
          y={module.y + 88}
          text-anchor="middle"
          fill="var(--muted)"
          font-size="8"
          letter-spacing="1.4"
        >
          {module.subtitle}
        </text>
      </g>
    ))}
  </svg>
</div>
