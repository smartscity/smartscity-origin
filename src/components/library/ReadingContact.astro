---
import { company } from '../../data/company';
import { dictionaries, type Locale } from '../../i18n';
interface Props {
  lang: Locale;
  title: string;
  path: string;
}
const { lang, title, path } = Astro.props;
const t = dictionaries[lang].library;
const inquiry = `/${lang}/contact/?${new URLSearchParams({ title, source: path })}#inquiry`;
---

<section class="reading-contact">
  <p class="eyebrow">SMARTSCITY</p>
  <h2>{t.contactTitle}</h2>
  <p>{t.contactText}</p>
  <div>
    {company.email && (
      <a class="button" href={inquiry}>
        {t.email} ↗
      </a>
    )}
    <a class="text-button" href={`/${lang}/contact/`}>
      {t.contact} →
    </a>
  </div>
  {company.email && <small>{company.email.value}</small>}
</section>
