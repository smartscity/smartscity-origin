---
import { dictionaries, type Locale } from '../../i18n';
import { company } from '../../data/company';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = dictionaries[lang].contactForm;
---

<form
  class="inquiry-form"
  data-contact-form
  data-recipient={company.email?.value}
  data-copy={JSON.stringify({
    draft: t.draft,
    copied: t.copied,
    copyFailed: t.copyFailed,
    name: t.name,
    organization: t.organization,
    topic: t.topic,
    message: t.message,
  })}
>
  <div class="form-heading">
    <span class="eyebrow">01 / {dictionaries[lang].nav.contact}</span>
    <h2>{t.formTitle}</h2>
    <p>{t.formIntro}</p>
  </div>
  <div class="form-pair">
    <label>
      {t.name}
      <input name="name" autocomplete="name" maxlength="100" required />
    </label>
    <label>
      {t.organization}
      <span class="field-optional">{t.optional}</span>
      <input name="organization" autocomplete="organization" maxlength="160" />
    </label>
  </div>
  <label>
    {t.topic}
    <select name="topic" required>
      {t.topics.map((topic) => (
        <option value={topic}>{topic}</option>
      ))}
    </select>
  </label>
  <label>
    {t.message}
    <textarea
      name="message"
      rows="7"
      minlength="10"
      maxlength="2000"
      placeholder={t.placeholder}
      aria-describedby="message-hint"
      required
    ></textarea>
  </label>
  <p class="field-hint" id="message-hint">
    {t.hint}
  </p>
  <p class="draft-note">
    {t.delivery} <a href={`/${lang}/privacy/`}>{t.privacy} ↗</a>
  </p>
  <noscript>
    <p class="connection-note">{t.nojs}</p>
  </noscript>
  <button class="inquiry-submit" type="submit" disabled>
    {t.submit}
    <span aria-hidden="true">↗</span>
  </button>
  <button class="inquiry-copy" type="button" data-copy-draft disabled>
    {t.copy}
  </button>
  <p
    class="inquiry-status"
    role="status"
    aria-live="polite"
    tabindex="-1"
    data-status
  ></p>
</form>
<script>
  import '../../lib/contact-form';
</script>
