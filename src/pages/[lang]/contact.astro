---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ContactForm from '../../components/contact/ContactForm.astro';
import '../../styles/contact.css';
import CompanyDetails from '../../components/CompanyDetails.astro';
import { company } from '../../data/company';
import { projects } from '../../data/projects';
import { locales, dictionaries, type Locale } from '../../i18n';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const t = dictionaries[lang];
---

<SiteLayout
  lang={lang}
  title={`${t.nav.contact} — ${company.brandName}`}
  description={t.contactPage.metaDescription}
>
  <section class="contact-hero container">
    <p class="eyebrow">{t.contactPage.eyebrow} / SMARTSCITY</p>
    <h1>{t.contactForm.title}</h1>
    <p class="contact-intro">{t.contactForm.intro}</p>
  </section>
  <section class="inquiry-layout container" aria-label={t.nav.contact}>
    <aside class="inquiry-aside">
      <div class="conversation-art" aria-hidden="true">
        <span>{t.contactForm.tag}</span>
        <div class="conversation-orbit">
          <i></i>
          <i></i>
          <i></i>
          <b>↗</b>
        </div>
        <p>{t.contactForm.side}</p>
        <small>SMARTSCITY / OPEN CONVERSATIONS</small>
      </div>
      <div class="inquiry-next">
        <h2>{t.contactForm.next}</h2>
        <ol>
          {t.contactForm.steps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
      </div>
      {company.email && (
        <div class="inquiry-direct">
          <p>{t.contactForm.direct}</p>
          <a data-company="email" href={`mailto:${company.email.value}`}>
            {company.email.value} ↗
          </a>
        </div>
      )}
    </aside>
    <ContactForm lang={lang} />
  </section>
  <section class="container inquiry-open-source">
    <div>
      <p class="eyebrow">02 / OPEN SOURCE</p>
      <h2>{t.contactForm.foot}</h2>
      <p>{t.contactForm.footText}</p>
    </div>
    <a class="text-button" href={company.githubOrganization}>
      {t.contactPage.githubCta} ↗
    </a>
  </section>
  <section class="corporate-section container corporate-split">
    <section class="identity-panel" aria-labelledby="contact-identity">
      <h2 id="contact-identity">{t.company.identityTitle}</h2>
      <CompanyDetails lang={lang} />
    </section>
    <div>
      <h2>{t.contactPage.projectsTitle}</h2>
      <div class="contact-projects">
        {projects.map((project) => (
          <a class="related-card" href={`/${lang}/projects/${project.id}/`}>
            {project.displayName}
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>
