---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { company } from '../../data/company';
import { locales, dictionaries, type Locale } from '../../i18n';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const t = dictionaries[lang];
---

<SiteLayout
  lang={lang}
  title={`${t.footer.privacy} — ${company.brandName}`}
  description={t.privacyExtra.metaDescription}
>
  <section class="prose-page container">
    <p class="eyebrow">{t.footer.privacy}</p>
    <h1>{t.privacy.title}</h1>
    <p>{t.privacy.description}</p>
    <div class="privacy-sections">
      {t.privacyExtra.sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          <p>{section.text}</p>
        </section>
      ))}
      <section>
        <h2>{t.privacyExtra.contactTitle}</h2>
        <p>{t.privacyExtra.contactText}</p>
        {company.email && (
          <a class="contact-email" href={`mailto:${company.email.value}`}>
            {company.email.value}
          </a>
        )}
        <a class="text-button" href={`/${lang}/contact/`}>
          {t.privacyExtra.contactCta} →
        </a>
      </section>
    </div>
  </section>
</SiteLayout>
